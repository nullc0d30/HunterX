{
  "capability": "offensive-tool-orchestration-and-full-mission-execution",
  "version": "1.0.0",
  "sprint": 20,
  "wave": 14,
  "status": "ratified",
  "summary": "The orchestration layer that turns authorized security missions into complete adaptive execution graphs: mission lifecycle (created → scoping → planning → ready → running → paused → waiting → replanning → blocked → completed | partial | failed | cancelled), capability-driven planning, scope enforcement before every task, safety/execution policy enforcement before every task, tool selection and chaining, dependency-graph execution with sequential/parallel/conditional/fan-out/fan-in semantics, retry/fallback/dedup/rate-limit engines, checkpoints and resume, persistent target mission memory, adaptive replanning that never expands scope, correlation feedback, coverage and mission quality scoring, canonical mission events, TIDB persistence and knowledge-graph updates. Never executes unrestricted exploitation; every task passes scope, safety and rate-limit gates before execution.",
  "inputs": {
    "mission": "mission_id, mission_type, objective, scope (roots/includes/excludes), exclusions, authorization, priority, policies (execution/safety/tool/retry/rate-limit), target_set, analysis_version",
    "target_intelligence": [
      "discovered assets (hostnames, IPs, CIDRs, URLs)",
      "known technologies (product:version)",
      "known services (http, https, dns, ...)",
      "known endpoints (web, api, js, cloud)",
      "cloud providers and resources",
      "authentication/authorization surfaces",
      "API surface"
    ],
    "vulnerability_intelligence": [
      "potential vulnerabilities (technology → CVE matches)",
      "CVSS/EPSS/KEV context",
      "risk assessments"
    ],
    "tool_capabilities": "TIP registry capabilities, target types, safety classes, installed state, reliability/health/performance",
    "scope_policy": "authorized roots, includes, excludes, follow_subdomains, follow_redirects",
    "mission_policies": "execution_policy, safety_policy, tool_policy, retry_policy, rate_limit_policy"
  },
  "outputs": {
    "missions": "canonical offensive missions with lifecycle state",
    "execution_plans": "phases (PHASE 0-12), steps, capabilities, dependencies, conditions, tools",
    "tool_selections": "capability-driven tool selections with scores, reasons and fallback chains",
    "step_outcomes": "canonical normalized step results (never raw stdout)",
    "coverage": "scope/asset/port/protocol/technology/endpoint/vulnerability/validation/tool/evidence coverage metrics",
    "quality": "explainable mission quality score with factor breakdown",
    "checkpoints": "persisted mission checkpoints for pause/resume/crash recovery",
    "target_memory": "persistent per-target mission memory",
    "replan_decisions": "adaptive replanning with in-scope/out-of-scope asset classification",
    "failure_reports": "classified failures (transient/rate-limit/timeout/network/tool-crash/parser/permanent) with management strategy",
    "events": "mission.* orchestration event stream",
    "graph_updates": "mission → plan → step relationships in the knowledge graph",
    "queries": [
      "missions", "mission by id", "plans", "plan by id",
      "missions by state", "target memory", "checkpoints"
    ]
  },
  "mission_types": [
    "bug-bounty", "web-pentest", "api-pentest", "external-assessment",
    "internal-assessment", "red-team-recon", "cloud-assessment",
    "continuous-attack-surface-monitoring", "vulnerability-assessment"
  ],
  "mission_lifecycle": [
    "created", "scoping", "planning", "ready", "running", "paused",
    "waiting", "replanning", "blocked", "completed", "partial",
    "failed", "cancelled"
  ],
  "phases": [
    "scope", "reconnaissance", "asset-discovery", "service-discovery",
    "technology-discovery", "attack-surface-mapping",
    "vulnerability-intelligence", "vulnerability-hypothesis",
    "safe-validation", "correlation", "risk-prioritization",
    "evidence-consolidation", "reporting"
  ],
  "execution_policies": [
    "passive-only", "safe-active", "standard-assessment", "authorized-red-team"
  ],
  "entities": [
    "MissionPlanRecord", "MissionPhaseRecord", "MissionStepRecord",
    "ExecutionDependency", "ExecutionCheckpoint", "ExecutionPolicyDecision",
    "ToolSelectionRecord", "ToolFallback", "MissionReplan",
    "MissionCoverage", "MissionQuality", "MissionFailure", "MissionTaskHistory"
  ],
  "tools": {
    "selection": "capability-driven via the Tool Intelligence Platform + registered execution adapters",
    "fallback": "capability-equivalent fallback selection preserving input/output contracts",
    "chaining": "tool A normalized output → tool B canonical input (never raw stdout cross-parsing)",
    "categories": [
      "reconnaissance", "dns", "subdomain-discovery", "http-discovery",
      "port-discovery", "service-enumeration", "web-crawling",
      "url-discovery", "technology-detection", "javascript-analysis",
      "api-discovery", "parameter-discovery", "content-discovery",
      "vulnerability-scanning", "tls-analysis", "cloud-enumeration",
      "container-intelligence", "dependency-intelligence", "secret-detection",
      "osint", "passive-intelligence", "attack-surface-management"
    ]
  },
  "events": [
    "mission.scoping.started", "mission.scoping.completed",
    "mission.planning.started", "mission.plan.created",
    "mission.phase.started", "mission.phase.completed",
    "mission.step.started", "mission.step.completed",
    "mission.step.failed", "mission.step.blocked",
    "mission.tool.selected", "mission.tool.started",
    "mission.tool.completed", "mission.tool.failed",
    "mission.tool.fallback", "mission.result.created",
    "mission.intelligence.updated", "mission.replanning.started",
    "mission.replanned", "mission.checkpoint.created",
