{
  "capability": "cloud-and-saas-attack-surface-intelligence",
  "version": "1.0.0",
  "sprint": 17,
  "wave": 11,
  "status": "ratified",
  "summary": "Persistent, evidence-backed cloud & SaaS attack-surface intelligence for authorized targets: cloud providers, accounts/subscriptions/projects/organizations/tenants, regions, resources, services, endpoints (control/data/identity/management plane), environments, identity & IAM indicators, SaaS platforms, SaaS applications, SaaS integrations, webhooks, third-party dependencies, storage/compute/container/Kubernetes/database/message/gateway/CDN/load-balancer/CI-CD resource indicators, secret-management indicators (references/fingerprints only), cloud exposure indicators (intelligence, never vulnerabilities) and historical change detection. Intelligence & discovery only; never authenticates to cloud accounts, never accesses cloud resources, never retrieves secrets and never exploits anything.",
  "inputs": {
    "targets": [
      "hostname", "domain", "ip", "url", "http-snapshot", "script", "document"
    ],
    "mission": "mission_id, target, mode (passive | active | hybrid), tools, parameters, min_confidence",
    "static_material": [
      "DNS records (CNAME targets, values, names)",
      "TLS certificate metadata (subject/issuer organization, SANs, wildcards)",
      "HTTP response headers (Server, x-amz-*, x-ms-*, cf-*, Via, ...)",
      "HTML content",
      "JavaScript script content (SDK references, endpoints, config)",
      "OpenAPI/API scheme hints",
      "Infrastructure documentation fragments (accounts, regions, roles, permissions)",
      "Technology observations (name, category, version)",
      "observed URLs (cloud hostnames, webhook endpoints, storage endpoints)"
    ],
    "existing_intelligence": [
      "previously persisted TIDB cloud intelligence",
      "DNS intelligence",
      "TLS intelligence",
      "technology intelligence",
      "JavaScript intelligence",
      "API intelligence",
      "authentication intelligence",
      "authorization intelligence",
      "web crawl intelligence"
    ],
    "historical": "cloud observation list for deterministic change detection",
    "scope_policy": "authorized domains, CIDRs, IPs, excluded names/cidrs/ips, excluded URL patterns"
  },
  "outputs": {
    "providers": "evidence-backed cloud provider inventory (AWS, Azure, GCP, Cloudflare, ...)",
    "accounts": "account/subscription/project/organization/tenant indicators",
    "regions": "cloud region/location indicators",
    "resources": "cloud resource indicators (bucket, instance, function, cluster, database, queue, ...)",
    "services": "classified cloud service inventory (EC2, S3, Lambda, App Service, Cloud Run, ...)",
    "endpoints": "cloud endpoints with control/data/identity/management plane + exposure classification",
    "environments": "production/staging/development/testing/QA/sandbox/preview/DR classifications",
    "identities": "cloud identity / IAM indicators (service accounts, users, roles, federated identity, ...)",
    "roles": "cloud IAM role indicators",
    "permissions": "documented cloud permission indicators",
    "integrations": "cloud/SaaS integration indicators",
    "saas_providers": "evidence-based SaaS platform inventory",
    "saas_applications": "SaaS application references",
    "saas_integrations": "SaaS OAuth/API/webhook integration indicators",
    "webhooks": "inbound/outbound webhook indicators (never signatures)",
    "dependencies": "third-party dependency relationships",
    "storage": "storage resource indicators (object/blob/file) with public-exposure classification",
    "compute": "compute/serverless resource indicators",
    "containers": "container/registry resource indicators",
    "kubernetes": "Kubernetes resource indicators (ingress, service, namespace, dashboard, helm)",
    "databases": "managed database resource indicators",
    "message_infrastructure": "message/event infrastructure indicators",
    "gateways": "API gateway / edge resource indicators",
    "cdns": "CDN resource indicators",
    "load_balancers": "load-balancer resource indicators",
    "cicd": "CI/CD infrastructure indicators",
    "secrets": "secret-management indicators (references/fingerprints only)",
    "exposures": "cloud exposure indicators as intelligence (never vulnerabilities)",
    "cloud_changes": "historical added/removed/changed events",
    "cloud_runs": "observability run records",
    "topology_relationships": "cloud architecture edges persisted into the existing TIDB topology",
    "queries": [
      "providers", "accounts", "regions", "resources", "services", "endpoints",
      "environments", "identities", "roles", "permissions", "integrations",
      "saas", "saas_applications", "saas_integrations", "webhooks",
      "dependencies", "storage", "compute", "containers", "kubernetes",
      "databases", "message_infrastructure", "gateways", "cdns",
      "load_balancers", "cicd", "secrets", "exposures", "observations",
      "changes", "runs", "summary"
    ]
  },
  "entities": [
    "CloudRun", "CloudProvider", "CloudAccount", "CloudRegion", "CloudResource",
    "CloudService", "CloudEndpoint", "CloudEnvironment", "CloudIdentity",
    "CloudRole", "CloudPermission", "CloudIntegration", "SaaSProvider",
    "SaaSApplication", "SaaSIntegration", "Webhook", "CloudDependency",
    "StorageResource", "ComputeResource", "ContainerResource",
    "KubernetesResource", "DatabaseResource", "MessageInfrastructure",
    "ApiGatewayResource", "CdnResource", "LoadBalancerResource",
    "CiCdResource", "SecretManagementIndicator", "CloudExposureIndicator",
    "CloudObservation", "CloudEvidence", "CloudChange"
  ],
  "tools": {
