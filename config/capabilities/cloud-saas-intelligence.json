  "permissions": ["none"],
  "scope_requirements": {
    "authorized_target_only": "target must pass the scope policy before any analysis runs",
    "per_observation_filter": "out-of-scope observations are never persisted",
    "no_scope_expansion": "discovered cloud intelligence never expands mission scope",
    "no_cloud_access": "the analyzer never authenticates, never requests cloud resources and never touches metadata services",
    "no_secret_retrieval": "secret-management indicators store references/fingerprints only",
    "deny_by_default": false,
    "fail_open_empty_policy": true
  },
  "sensitive_data_protection": {
    "never_persist": [
