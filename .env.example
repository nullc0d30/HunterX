#
# HunterX AI configuration template.
#
# Getting started:
#   1. Copy this file to `.env`
#   2. Edit `.env` (set provider, model and your API key)
#   3. Run HunterX normally
#
# The real `.env` is local/private and must NEVER be committed (it is already
# ignored by `.gitignore`). You can also supply these values as environment
# variables directly - e.g. via Docker `--env-file`, CI, or Kubernetes
# secrets. AI configuration is optional: HunterX runs fine without any of it.

# AI provider. Supported:
#   openrouter, openai, anthropic, gemini, deepseek, grok,
#   lmstudio, ollama, openai_compatible
HUNTERX_AI_PROVIDER=openrouter

# Default model identifier.
HUNTERX_AI_MODEL=deepseek/deepseek-chat

# Base URL for OpenAI-compatible providers (LM Studio, Ollama, openai_compatible, etc.).
# Examples:
#   LM Studio:    http://127.0.0.1:1234/v1
#   Ollama:       http://127.0.0.1:11434/v1
#   Custom:       http://your-endpoint:PORT/v1
HUNTERX_AI_BASE_URL=

# Per-request timeout in seconds.
HUNTERX_AI_TIMEOUT=120.0

# OpenRouter API key - paste your real key here (never share or commit it).
HUNTERX_AI_OPENROUTER_KEY=

# Keys for other providers are read from these variables when their adapter is
# configured:
HUNTERX_AI_OPENAI_KEY=
HUNTERX_AI_ANTHROPIC_KEY=
HUNTERX_AI_GEMINI_KEY=
HUNTERX_AI_DEEPSEEK_KEY=
HUNTERX_AI_GROK_KEY=
HUNTERX_AI_LMSTUDIO_KEY=
HUNTERX_AI_OLLAMA_KEY=
HUNTERX_AI_OPENAI_COMPATIBLE_KEY=