{
  "capability": "professional-finding-reporting",
  "name": "Professional Finding Intelligence & Reporting Engine",
  "version": "1.0.0",
  "wave": 14,
  "sprint": 29,
  "status": "ratified",
  "description": "The evidence-backed capability that transforms a validated finding plus evidence, proof, impact, provenance, target intelligence and correlation into a professional security report package appropriate for bug bounty, vulnerability disclosure, pentest, web/app/API pentest, cloud assessment, red team, attack surface assessment, security research and internal security validation. The reporting engine never manufactures facts: every statement traces to observation, evidence, validation, proof, impact, tool result, target intelligence or explicit analyst reasoning.",
  "inputs": [
    "validated FindingPackage (Sprint 028 output)",
    "evidence items and evidence assessment",
    "validation attempts and results",
    "proof / PoC artifacts and replay records",
    "impact and confidence assessments",
    "deduplication decisions and root-cause records",
    "target intelligence and asset criticality",
    "attack-path intelligence",
    "TIDB repository factory",
    "event bus",
    "report exporter port (reporting adapter)"
  ],
  "outputs": [
    "FindingIntelligence aggregate",
    "Classification (CWE / OWASP / CAPEC / CVE / CVSS / ATT&CK)",
    "SeverityAssessment",
    "FindingQuality",
    "PriorityAssessment (P0-P4)",
    "Reportability verdict",
    "BusinessImpact",
    "EvidenceBundle (immutable, integrity-hashed)",
    "FindingTimeline",
    "ToolProvenance records",
    "SourceReliabilityModel",
    "RemediationPlan",
    "RetestPlan",
    "ReportClaim records (verified)",
    "ReportQaResult",
    "ReportRedaction metadata",
    "immutable ReportVersion and ReportPackage",
    "executive summaries and cross-finding correlation reports",
    "Markdown / HTML / JSON / SARIF / PDF / package exports"
  ],
